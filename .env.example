# X11転送用ディスプレイ設定
# ローカル表示の場合: DISPLAY=:0
# リモート表示の場合: DISPLAY=192.168.x.x:0.0
DISPLAY=:0

# ROS2ドメインID（同一ネットワーク内の別システムと干渉しないよう設定）
ROS_DOMAIN_ID=10

# --- 起動モード（docker compose の launch 引数。省略時は右のデフォルト値） ---
# ※ いずれも起動時の初期値。稼働中は再起動なしに ros2 param set で切替可能。
# cv2デバッグ窓の表示のみ（顔データ保存は伴わない。デフォルト: true）
DEBUG_MODE=true
# 追跡デバッグ画像をローカルディスクに保存（手元解析用。Web配信は常時なので無関係。デフォルト: false）
SAVE_IMAGE=false
# 横顔プロフィール特徴の配信・学習（デフォルト: false）
ENABLE_PROFILE=false
# 自動登録ユーザーの顔特徴・画像・PCAモデルのディスク保存（DEBUG_MODEとは独立。デフォルト: false）
SAVE_REGISTRATION=false
# PCA API に辞書の全特徴点を含めて配信（デフォルト: false＝ライブ点のみ）
SHOW_FULL_DICTIONARY=false
# 日本時間 3:00 に face_models を別 private リポジトリへ定時 push（デフォルト: false）
PUSH_FACE_MODELS=false
# コンテナ内のバックアップ用 git 作業コピーパス
FACE_MODELS_BACKUP_REPO=/root/face_models_after_Adaface
# ホスト側の clone 先（docker volume マウント元）
FACE_MODELS_BACKUP_REPO_HOST=~/face_models_after_Adaface
